@context
typelib RGBContract

import Tondi#process-poem-cobalt
  use Vout#section-regular-proxy
  use Outpoint#child-delta-disney
  use Txid#gibson-energy-maximum

import Std#sister-triton-cricket
  use AlphaNum#strong-iron-travel
  use Alpha#vacuum-serpent-mambo
  use AsciiPrintable#valid-house-fame


@mnemonic(fantasy-labor-truck)
data Amount            : U64

@mnemonic(edition-congo-snake)
data AssetName         : Std.AsciiPrintable, [Std.AsciiPrintable ^ ..0x27]

@mnemonic(split-vampire-bundle)
data Details           : Std.AsciiPrintable, [Std.AsciiPrintable ^ ..0xfe]

@mnemonic(evident-archer-slang)
data Precision         : indivisible | deci | centi | milli
                       | deciMilli | centiMilli | micro | deciMicro
                       | centiMicro | nano | deciNano | centiNano
                       | pico | deciPico | centiPico | femto
                       | deciFemto | centiFemto | atto


@mnemonic(yogurt-hawaii-opera)
data ProofOfReserves   : utxo Tondi.Outpoint, proof [Byte]

@mnemonic(alfred-octavia-nelson)
data Ticker            : Std.Alpha, [Std.AlphaNum ^ 1..0x7]


