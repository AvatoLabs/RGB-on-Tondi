@context
typelib BPCore

import CommitVerify#clark-blonde-karma
  use MerkleProof#aroma-mirror-match
  use MerkleHash#ivory-spoon-imitate
  use ReservedBytes1#marco-balsa-meaning
  use ProtocolId#armada-immune-martin
  use Message#baker-judge-miranda
  use Method#horse-justice-select

import Tondi#process-poem-cobalt
  use Vout#section-regular-proxy
  use LeafVer#normal-deal-aspirin
  use Outpoint#child-delta-disney
  use CompressedPk#summer-animal-shrink
  use InternalPk#comrade-austria-pearl
  use LeafScript#tropic-circle-aspirin
  use Txid#gibson-energy-maximum
  use ScriptBytes#double-ricardo-lunar
  use TapNodeHash#exodus-design-father
  use XOnlyPk#input-compact-flower

import Std#sister-triton-cricket
  use U5#nebula-quarter-sharon


@mnemonic(shave-music-service)
data Anchor            : mmbProof BundleProof
                       , mpcProtocol CommitVerify.ProtocolId
                       , mpcProof CommitVerify.MerkleProof
                       , dbcProof TapretProof?
                       , p2mrProof TondiP2mrProof?
                       , fallbackProof CommitVerify.ReservedBytes1

@mnemonic(golf-bruno-ricardo)
data BundleProof       : map {U32 -> Message}

@mnemonic(baker-judge-miranda)
data Message           : [Byte ^ 32]

@mnemonic(contact-think-karma)
data MessageMap        : {CommitVerify.ProtocolId -> ^ ..0xffffff MessageSource}

@mnemonic(mama-join-robin)
data MessageSource     : single#1 CommitVerify.Message
                       | mmb BundleProof

@mnemonic(john-gentle-capital)
data Noise             : [Byte ^ 40]

@mnemonic(lucas-exact-safari)
data Source            : minDepth Std.U5
                       , entropy U64
                       , messages MessageMap

@mnemonic(pegasus-vista-bonjour)
data TapretNodePartner : leftNode Tondi.TapNodeHash
                       | rightLeaf Tondi.LeafScript
                       | rightBranch TapretRightBranch

@mnemonic(cool-serpent-journal)
data TapretPathProof   : partnerNode TapretNodePartner?, nonce U8

@mnemonic(stone-vertigo-between)
data TapretProof       : pathProof TapretPathProof, internalPk Tondi.InternalPk

@mnemonic(regard-nixon-morning)
data TapretRightBranch : leftNodeHash Tondi.TapNodeHash, rightNodeHash Tondi.TapNodeHash

@mnemonic(nominal-october-forward)
data TondiP2mrProof    : originalPubkey Tondi.CompressedPk

@mnemonic(page-baron-robert)
data TxoSeal           : primary Tondi.Outpoint, secondary TxoSealExt

@mnemonic(gibson-nina-ritual)
data TxoSealExt        : noise Noise
                       | fallback Tondi.Outpoint

@mnemonic(cable-diagram-museum)
data WOutpoint         : wout Tondi.Vout
                       | extern Tondi.Outpoint

@mnemonic(isabel-phrase-monarch)
data WTxoSeal          : primary WOutpoint, secondary TxoSealExt


